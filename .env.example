# Claude API (https://console.anthropic.com). Without it, Mirrah runs with mock AI.
ANTHROPIC_API_KEY=
# Optional model overrides
MIRRAH_MODEL_SMART=claude-sonnet-5-5
MIRRAH_MODEL_FAST=claude-haiku-5-5

# Supabase (Project Settings > API). Without both, Mirrah uses the local demo file store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Operator panel password (/ops and /dashboard). Required in production.
OPS_PASSWORD=

# Inngest (https://app.inngest.com). Without these, probes launch immediately (demo mode).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# For local development with the Inngest dev server: INNGEST_DEV=1

APP_URL=http://localhost:3000

# Email via Postmark (https://postmarkapp.com). Without the token, emails are logged and skipped.
POSTMARK_SERVER_TOKEN=
# System mail to owners (verified sender signature)
MAIL_FROM=
# The mystery customer's sender. Use a verified sender that does not reveal Mirrah.
MAIL_PROBE_FROM=
# Postmark inbound address (Servers > Inbound stream), e.g. abc123@inbound.postmarkapp.com
POSTMARK_INBOUND_ADDRESS=
# Set the inbound webhook URL to https://<app>/api/inbound/email?secret=<this value>
INBOUND_WEBHOOK_SECRET=
