# Claude API (https://console.anthropic.com). Without it, Mirrah runs with mock AI.
ANTHROPIC_API_KEY=
# Optional model overrides
MIRRAH_MODEL_SMART=claude-sonnet-5-5
MIRRAH_MODEL_FAST=claude-haiku-5-5

# Supabase (Project Settings > API). Without both, Mirrah uses the local demo file store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Operator panel password (/ops and /dashboard). Required in production.
OPS_PASSWORD=

# Inngest (https://app.inngest.com). Without these, probes launch immediately (demo mode).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# For local development with the Inngest dev server: INNGEST_DEV=1

APP_URL=http://localhost:3000
